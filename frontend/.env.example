# Public API origin only. Never place access tokens, client secrets, or private keys in VITE_* variables.
VITE_AEGIS_API_BASE_URL=https://api.example.invalid

# Optional public OIDC SPA client configuration. Leave unset until a provider and exact callback URI are registered.
# Uses Authorization Code + PKCE S256; browser clients must not have a client secret.
# VITE_AEGIS_OIDC_ISSUER=https://identity.example.invalid
# VITE_AEGIS_OIDC_CLIENT_ID=public-spa-client-id
# VITE_AEGIS_OIDC_REDIRECT_URI=https://portal.example.invalid/auth/callback
